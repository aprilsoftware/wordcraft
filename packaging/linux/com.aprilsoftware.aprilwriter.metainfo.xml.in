<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>com.aprilsoftware.aprilwriter</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>April Writer</name>
  <summary>Write and design documents; open and save Word files</summary>
  <developer id="com.aprilsoftware">
    <name>April Software S.A.</name>
  </developer>
  <description>
    <p>
      April Writer is an open-source word processor with a familiar ribbon. It supports styles, tables, track changes, references, mail merge, and DOCX, PDF, ODT, RTF, HTML and Markdown files. It can also be automated through MCP.
    </p>
  </description>
  <launchable type="desktop-id">com.aprilsoftware.aprilwriter.desktop</launchable>
  <icon type="stock">com.aprilsoftware.aprilwriter</icon>
  <!-- Only URL types known to appstream 0.15 (Ubuntu 22.04, where CI validates). -->
  <url type="homepage">https://www.aprilsoftware.com</url>
  <url type="help">https://github.com/aprilsoftware/wordcraft</url>
  <categories>
    <category>Office</category>
    <category>WordProcessor</category>
  </categories>
  <keywords>
    <keyword>word processor</keyword>
    <keyword>docx</keyword>
    <keyword>document</keyword>
    <keyword>writer</keyword>
  </keywords>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>tablet</control>
  </supports>
  <!-- Document types April Writer opens, as in the desktop entry's MimeType=. -->
  <provides>
    <binary>aprilwriter</binary>
    <mediatype>application/vnd.openxmlformats-officedocument.wordprocessingml.document</mediatype>
    <mediatype>application/vnd.ms-word.document.macroEnabled.12</mediatype>
    <mediatype>application/vnd.openxmlformats-officedocument.wordprocessingml.template</mediatype>
    <mediatype>application/vnd.ms-word.template.macroEnabled.12</mediatype>
    <mediatype>application/msword</mediatype>
    <mediatype>application/msword-template</mediatype>
    <mediatype>application/vnd.oasis.opendocument.text</mediatype>
    <mediatype>application/rtf</mediatype>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
