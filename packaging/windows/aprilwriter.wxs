<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <?ifndef HasCraftFontLicences ?>
  <?define HasCraftFontLicences=0 ?>
  <?endif?>
  <Package Name="April Writer" Manufacturer="April Software S.A." Version="$(var.Version)" UpgradeCode="4F29209C-6805-45BD-8D02-FD655CC6C1AC" Scope="perUserOrMachine" Compressed="yes" Language="1033">
    <SummaryInformation Description="April Writer word processor" Manufacturer="April Software S.A." />
    <?include $(sys.SOURCEFILEDIR)install-policy.wxi?>
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of April Writer is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AprilWriterIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="AprilWriterIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://www.aprilsoftware.com" />
    <Property Id="ARPHELPLINK" Value="mailto:contact@aprilsoftware.com" />

    <!-- Installer UI (#198): WixUI_Minimal is welcome + license, progress, then a finish page so
         people can see the install worked. Its dialogs and bitmaps are WiX's own
         (WixToolset.UI.wixext); package.ps1 builds the license RTF from LICENSE-MIT and
         LICENSE-APACHE. The finish page offers to launch April Writer (ticked by default) through
         WixShellExec (WixToolset.Util.wixext); silent installs (/qn) never show it. -->
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch April Writer" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#AprilWriterExe]" />
    <CustomAction Id="LaunchAprilWriter" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
    <UI>
      <ui:WixUI Id="WixUI_Minimal" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchAprilWriter" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="AprilSuiteFolder" Name="April Software">
        <Directory Id="INSTALLFOLDER" Name="April Writer" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="April Writer" Level="1">
      <ComponentGroupRef Id="AppNotices" />
      <?if $(var.HasCraftFontLicences) = 1 ?>
      <ComponentGroupRef Id="CraftFontLicences" />
      <?endif?>
      <ComponentGroupRef Id="AprilWriterFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="AppNotices" Directory="INSTALLFOLDER">
      <Files Include="$(var.AppNoticesDir)\**" />
    </ComponentGroup>
    <?if $(var.HasCraftFontLicences) = 1 ?>
    <ComponentGroup Id="CraftFontLicences" Directory="INSTALLFOLDER">
      <Files Include="$(var.DocsDir)\**" />
    </ComponentGroup>
    <?endif?>
    <ComponentGroup Id="AprilWriterFiles" Directory="INSTALLFOLDER">
      <Component Id="AprilWriterApp" Guid="CBD8D0AB-09B3-4F78-9EC8-BFC0F03ACF86">
        <File Id="AprilWriterExe" Source="$(var.BinDir)\aprilwriter.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="April Writer" Description="April Writer word processor" WorkingDirectory="INSTALLFOLDER" Advertise="yes" Icon="AprilWriterIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKMU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\aprilwriter.exe" Value="[#AprilWriterExe]" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\April Software\April Writer" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

      <!-- Each document type gets an AprilWriter ProgId and is listed under the extension's
           OpenWithProgids, so April Writer appears in Explorer's Open with list. The Word, RTF
           and ODT types are also April Writer's Capabilities (RegisteredApplications), so it
           appears in Settings > Default apps. Nothing here takes over an extension by default.
           Markdown and plain text are only Open with candidates. Removed again on uninstall. -->
      <Component Id="AprilWriterFileTypes" Guid="7AFD3EE1-5E76-4ACE-8173-8D8A6ED20DC0">
        <RegistryValue Root="HKMU" Key="Software\RegisteredApplications" Name="April Writer" Value="Software\April Software\April Writer\Capabilities" Type="string" KeyPath="yes" />
        <RegistryValue Root="HKMU" Key="Software\April Software\April Writer\Capabilities" Name="ApplicationName" Value="April Writer" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\April Software\April Writer\Capabilities" Name="ApplicationDescription" Value="Write and design documents; open and save Word files." Type="string" />
        <RegistryValue Root="HKMU" Key="Software\April Software\April Writer\Capabilities" Name="ApplicationIcon" Value="&quot;[#AprilWriterExe]&quot;,0" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\aprilwriter.exe" Name="FriendlyAppName" Value="April Writer" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\aprilwriter.exe\shell\open\command" Value="&quot;[#AprilWriterExe]&quot; &quot;%1&quot;" Type="string" />

        <ProgId Id="AprilWriter.Document" Description="Word Document" Icon="AprilWriterExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\AprilWriter.Document\shell\open\command" Value="&quot;[#AprilWriterExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.docx\OpenWithProgids" Name="AprilWriter.Document" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\aprilwriter.exe\SupportedTypes" Name=".docx" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\April Software\April Writer\Capabilities\FileAssociations" Name=".docx" Value="AprilWriter.Document" Type="string" />

        <ProgId Id="AprilWriter.DocumentMacroEnabled" Description="Word Macro-Enabled Document" Icon="AprilWriterExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\AprilWriter.DocumentMacroEnabled\shell\open\command" Value="&quot;[#AprilWriterExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.docm\OpenWithProgids" Name="AprilWriter.DocumentMacroEnabled" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\aprilwriter.exe\SupportedTypes" Name=".docm" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\April Software\April Writer\Capabilities\FileAssociations" Name=".docm" Value="AprilWriter.DocumentMacroEnabled" Type="string" />

        <ProgId Id="AprilWriter.Template" Description="Word Template" Icon="AprilWriterExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\AprilWriter.Template\shell\open\command" Value="&quot;[#AprilWriterExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.dotx\OpenWithProgids" Name="AprilWriter.Template" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\aprilwriter.exe\SupportedTypes" Name=".dotx" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\April Software\April Writer\Capabilities\FileAssociations" Name=".dotx" Value="AprilWriter.Template" Type="string" />

        <ProgId Id="AprilWriter.TemplateMacroEnabled" Description="Word Macro-Enabled Template" Icon="AprilWriterExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\AprilWriter.TemplateMacroEnabled\shell\open\command" Value="&quot;[#AprilWriterExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.dotm\OpenWithProgids" Name="AprilWriter.TemplateMacroEnabled" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\aprilwriter.exe\SupportedTypes" Name=".dotm" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\April Software\April Writer\Capabilities\FileAssociations" Name=".dotm" Value="AprilWriter.TemplateMacroEnabled" Type="string" />

        <ProgId Id="AprilWriter.LegacyDocument" Description="Legacy Word Document" Icon="AprilWriterExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\AprilWriter.LegacyDocument\shell\open\command" Value="&quot;[#AprilWriterExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.doc\OpenWithProgids" Name="AprilWriter.LegacyDocument" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\aprilwriter.exe\SupportedTypes" Name=".doc" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\April Software\April Writer\Capabilities\FileAssociations" Name=".doc" Value="AprilWriter.LegacyDocument" Type="string" />

        <ProgId Id="AprilWriter.LegacyTemplate" Description="Legacy Word Template" Icon="AprilWriterExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\AprilWriter.LegacyTemplate\shell\open\command" Value="&quot;[#AprilWriterExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.dot\OpenWithProgids" Name="AprilWriter.LegacyTemplate" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\aprilwriter.exe\SupportedTypes" Name=".dot" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\April Software\April Writer\Capabilities\FileAssociations" Name=".dot" Value="AprilWriter.LegacyTemplate" Type="string" />

        <ProgId Id="AprilWriter.RichText" Description="Rich Text Document" Icon="AprilWriterExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\AprilWriter.RichText\shell\open\command" Value="&quot;[#AprilWriterExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.rtf\OpenWithProgids" Name="AprilWriter.RichText" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\aprilwriter.exe\SupportedTypes" Name=".rtf" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\April Software\April Writer\Capabilities\FileAssociations" Name=".rtf" Value="AprilWriter.RichText" Type="string" />

        <ProgId Id="AprilWriter.OpenDocumentText" Description="OpenDocument Text" Icon="AprilWriterExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\AprilWriter.OpenDocumentText\shell\open\command" Value="&quot;[#AprilWriterExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.odt\OpenWithProgids" Name="AprilWriter.OpenDocumentText" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\aprilwriter.exe\SupportedTypes" Name=".odt" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\April Software\April Writer\Capabilities\FileAssociations" Name=".odt" Value="AprilWriter.OpenDocumentText" Type="string" />

        <ProgId Id="AprilWriter.Markdown" Description="Markdown Document" Icon="AprilWriterExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\AprilWriter.Markdown\shell\open\command" Value="&quot;[#AprilWriterExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.md\OpenWithProgids" Name="AprilWriter.Markdown" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\aprilwriter.exe\SupportedTypes" Name=".md" Value="" Type="string" />

        <ProgId Id="AprilWriter.PlainText" Description="Text Document" Icon="AprilWriterExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\AprilWriter.PlainText\shell\open\command" Value="&quot;[#AprilWriterExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.txt\OpenWithProgids" Name="AprilWriter.PlainText" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\aprilwriter.exe\SupportedTypes" Name=".txt" Value="" Type="string" />
      </Component>

      <Component Id="AprilWriterCli">
        <File Id="AprilWriterCliExe" Source="$(var.BinDir)\aprilwriter-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
